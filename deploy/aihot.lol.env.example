# aihot.lol 的 Docker + Caddy 配置模板。复制到仓库根目录 .env 后填入本地/平台密钥。
# 当前只是模板；生产服务器、模型服务和预算尚未确认。
SITE_URL=https://aihot.lol
SITE_DOMAIN=aihot.lol
PORT=127.0.0.1:3000
TRUST_PROXY=true

# 必须填入随机密钥。不要提交完整 .env，不要用数据库示例默认密码。
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=
POSTGRES_PASSWORD=

# 未确定服务和每日预算前，保持模型和采集关闭。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
